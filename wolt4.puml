@startuml WOLT4

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ===================== FRONTEND (Ex4 - React) =====================

package "React App (Ex4)" {

    class AppRoot {
        +render(): JSX
        ' BrowserRouter + Routes, loaded once (no refresh)
    }

    package "contexts" {
        class AuthContext {
            +user: User
            +token: string (JWT)
            +login(username, password): Promise
            +register(userData): Promise
            +logout(): void
            +isAuthenticated(): boolean
        }

        class ThemeContext {
            +theme: "light" | "dark"
            +toggleTheme(): void
        }

        class CartContext {
            +items: CartItem[]
            +restaurantId: string
            +addItem(product, qty): void
            +removeItem(productId): void
            +updateQty(productId, qty): void
            +total(): number
            +clear(): void
        }
    }

    package "services" {
        class ApiClient {
            -BASE_URL: string
            -authHeaders(): object  ' attaches JWT
            +post(path, body): Promise
            +get(path): Promise
            +put(path, body): Promise
            +delete(path): Promise
        }

        class UsersApi {
            +createUser(data): Promise
            +getUser(id): Promise
        }

        class TokensApi {
            +login(username, password): Promise<JWT>
        }

        class RestaurantsApi {
            +getAll(): Promise
            +getById(id): Promise
            +create(data): Promise
            +update(id, data): Promise
            +delete(id): Promise
        }

        class ProductsApi {
            +getByRestaurant(rid): Promise
            +create(rid, data): Promise
            +update(id, data): Promise
            +delete(id): Promise
        }

        class OrdersApi {
            +create(order): Promise
            +getByUser(): Promise
            +getById(id): Promise
            +update(id, data): Promise
            +delete(id): Promise
        }

        class SearchApi {
            +search(query): Promise
        }
    }

    package "pages" {
        class LoginPage {
            -username, password: useState
            -errorRef: useRef
            +validate(): boolean
            +handleSubmit(): void
        }

        class RegisterPage {
            -fields: useState
            -fileInputRef: useRef
            +validate(): boolean  ' required, pwd>=8, chars+letters, confirm
            +previewImage(): void
            +handleSubmit(): void
        }

        class HomePage {
            -restaurants: useState
            -categories: useState
            +fetchRestaurants(): void
        }

        class SearchResultsPage {
            -results: useState
        }

        class RestaurantPage {
            -restaurant, products: useState
        }

        class CheckoutPage {
            +placeOrder(): void
        }

        class OrdersPage {
            -orders: useState
        }

        class AdminRestaurantPage {
            ' create / edit restaurant + manage menu
            +saveRestaurant(): void
            +saveProduct(): void
        }
    }

    package "components" {
        class NavBar {
            ' logo, SearchBar, user info / login btn, theme toggle
        }
        class SearchBar {
            -query: useState
            -inputRef: useRef
        }
        class ProtectedRoute {
            ' redirects to /login if no JWT
        }
        class RestaurantCard
        class CategoryRow
        class ProductCard
        class CartSidebar
        class OrderItem
        class ThemeToggle
        class ValidatedInput {
            ' visual validation feedback
        }
    }
}

' ===================== BACKEND (Ex3 - unchanged) =====================

package "Ex3 Node Server" {

    class App {
        +listen(port): void
        ' serves React build at "/"
    }

    package "routes" {
        class UsersRoutes
        class TokensRoutes
        class RestaurantsRoutes
        class ProductsRoutes
        class OrdersRoutes
        class SearchRoutes
    }

    package "middleware" {
        class AuthMiddleware {
            +verifyJWT(req, res, next): void
        }
        class Validators {
            +validateUser(req, res, next): void
            +validateRestaurant(req, res, next): void
            +validateProduct(req, res, next): void
            +validateOrder(req, res, next): void
        }
    }

    package "controllers" {
        class UsersController {
            +createUser(req, res): void
            +getUserById(req, res): void
        }
        class TokensController {
            +login(req, res): void
        }
        class RestaurantsController {
            +getAll(req, res): void
            +create(req, res): void
            +getById(req, res): void
            +update(req, res): void
            +delete(req, res): void
        }
        class ProductsController {
            +getByRestaurant(req, res): void
            +create(req, res): void
            +getById(req, res): void
            +update(req, res): void
            +delete(req, res): void
        }
        class OrdersController {
            +create(req, res): void
            +getByUser(req, res): void
            +getById(req, res): void
            +update(req, res): void
            +delete(req, res): void
        }
        class SearchController {
            +search(req, res): void
        }
    }

    package "models" {
        class User {
            +id: string
            +username: string
            +password: string
            +name: string
            +image: string
            +phone: string
            +address: string
        }
        class Restaurant {
            +id: string
            +name: string
            +description: string
            +cuisine: string
            +address: string
            +image: string
        }
        class Product {
            +id: string
            +restaurantId: string
            +name: string
            +description: string
            +price: number
            +image: string
        }
        class Order {
            +id: string
            +userId: string
            +restaurantId: string
            +products: Product[]
            +status: string
            +total: number
        }
    }

    package "services" {
        class Ex2Client {
            -EX2_HOST: string
            -EX2_PORT: number
            -sendToEx2(command, args): Promise
            +addUserProducts(userId, productIds): Promise
            +patchUserProducts(userId, productIds): Promise
            +getRecommendations(userId): Promise
            +deleteUser(userId): Promise
        }
    }
}

class "Ex2 C++ Server (TCP :8080)" as Ex2Server << (S,#FF7700) >>

' ===================== FRONTEND WIRING =====================

AppRoot --> AuthContext
AppRoot --> ThemeContext
AppRoot --> CartContext
AppRoot --> NavBar
AppRoot --> ProtectedRoute

AppRoot --> LoginPage
AppRoot --> RegisterPage
AppRoot --> HomePage
AppRoot --> SearchResultsPage
AppRoot --> RestaurantPage
AppRoot --> CheckoutPage
AppRoot --> OrdersPage
AppRoot --> AdminRestaurantPage

NavBar --> SearchBar
NavBar --> ThemeToggle
ThemeToggle --> ThemeContext

ProtectedRoute --> AuthContext
ProtectedRoute ..> CheckoutPage : guards
ProtectedRoute ..> OrdersPage : guards
ProtectedRoute ..> AdminRestaurantPage : guards

LoginPage --> TokensApi
LoginPage --> AuthContext
LoginPage --> ValidatedInput
RegisterPage --> UsersApi
RegisterPage --> ValidatedInput

HomePage --> RestaurantsApi
HomePage --> CategoryRow
CategoryRow --> RestaurantCard
SearchBar --> SearchApi
SearchResultsPage --> SearchApi

RestaurantPage --> ProductsApi
RestaurantPage --> ProductCard
ProductCard --> CartContext
CartSidebar --> CartContext
CheckoutPage --> CartContext
CheckoutPage --> OrdersApi
OrdersPage --> OrdersApi
OrdersPage --> OrderItem

AdminRestaurantPage --> RestaurantsApi
AdminRestaurantPage --> ProductsApi

UsersApi --|> ApiClient
TokensApi --|> ApiClient
RestaurantsApi --|> ApiClient
ProductsApi --|> ApiClient
OrdersApi --|> ApiClient
SearchApi --|> ApiClient

ApiClient --> App : HTTP REST + JWT

' ===================== BACKEND WIRING =====================

App --> UsersRoutes
App --> TokensRoutes
App --> RestaurantsRoutes
App --> ProductsRoutes
App --> OrdersRoutes
App --> SearchRoutes

UsersRoutes --> Validators
RestaurantsRoutes --> AuthMiddleware
ProductsRoutes --> AuthMiddleware
OrdersRoutes --> AuthMiddleware
RestaurantsRoutes --> Validators
ProductsRoutes --> Validators
OrdersRoutes --> Validators

UsersRoutes --> UsersController
TokensRoutes --> TokensController
RestaurantsRoutes --> RestaurantsController
ProductsRoutes --> ProductsController
OrdersRoutes --> OrdersController
SearchRoutes --> SearchController

UsersController --> User
TokensController --> User
RestaurantsController --> Restaurant
ProductsController --> Product
OrdersController --> Order
SearchController --> Restaurant
SearchController --> Product

ProductsController --> Ex2Client
UsersController --> Ex2Client
Ex2Client --> Ex2Server : TCP socket

@enduml
